# Copy to .env.emergency (never commit it) and fill in the same values
# you have in Vercel → Settings → Environment Variables.
# docs/emergency-hosting.md explains each step.

# --- Public (also baked into the browser code) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://partners-fx.trade
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- Server secrets (stay on this machine) ---------------------------------
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_HOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_SIGNALS_CHAT_ID=
