# ---------------------------------------------------------------------------
# FX Partners — Environment Variables
# Copy this file to `.env.local` and fill the values from your Supabase project
# (Supabase Dashboard → Project Settings → API).
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL (used for building referral links / auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER expose this to the browser. Used for admin/server actions.
# Leave empty unless you add server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=
