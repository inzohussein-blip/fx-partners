# ---------------------------------------------------------------------------
# FX Partners — Environment Variables
# Copy this file to `.env.local` and fill the values from your Supabase project
# (Supabase Dashboard → Project Settings → API).
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL (used for building referral links / auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER expose this to the browser. Used for admin/server actions
# and for sending emails from hooks that have no user session.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that guards the welcome-email hook (/api/hooks/new-partner).
# Must match app.settings.welcome_hook_secret set on the database (migration 0003).
EMAIL_HOOK_SECRET=

# Twelve Data API key for live market prices (server-only; proxied via
# /api/markets). Get a free key at twelvedata.com. Without it, the homepage
# chart falls back to simulated demo data.
TWELVEDATA_API_KEY=
